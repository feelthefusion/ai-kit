#!/usr/bin/env bash
# =============================================================================
# AI Kit — living updates.  Event-driven: runs when YOU start a session, never on a timer.
#
#   ai-update              check every component's upstream now, apply what changed
#   ai-update --check      report what changed upstream, apply nothing
#   ai-update --status     components, last-seen revision, last check
#   ai-update --deps       in an app repo: AI packages behind npm latest (ai, @ai-sdk/*, openrouter…)
#   ai-update --deps --apply   …and upgrade them (npm/pnpm/yarn/bun — whichever the repo uses)
#   ai-update --hook       (Claude Code SessionStart / Hermes on_session_start) — background
#
# Detection: one `git ls-remote` per upstream repo (the kit + every curated-skill repo), in
# parallel (~1s). Only components whose revision moved get updated. The hook also notes, for the
# repo you opened, AI packages that fell behind npm — so the site's AI never quietly ages.
#
#   AI_UPDATE_TTL=300   seconds a check result is reused (many sessions at once = 1 check)
#   AI_UPDATE=off       disable (the hook becomes a no-op)
# =============================================================================
set -uo pipefail
SELF="${BASH_SOURCE[0]}"; while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
KIT_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ai-kit"
STATE="$CONF/update-state.json"; LOG="$CONF/update.log"; NOTICE="$CONF/update-notice.txt"; LOCK="$CONF/update.lock"
TTL="${AI_UPDATE_TTL:-300}"
GIT_BASE="${AI_GIT_BASE:-https://github.com}"
AI_UPSTREAM="${AI_UPSTREAM:-${XDG_DATA_HOME:-$HOME/.local/share}/ai-kit/upstream}"
mkdir -p "$CONF"

find_claude() {
    command -v claude 2>/dev/null && return
    local d="$HOME/Library/Application Support/Claude/claude-code"
    [ -d "$d" ] && ls -d "$d"/*/claude.app/Contents/MacOS/claude 2>/dev/null | sort -V | tail -1
}
CLAUDE_BIN="$(find_claude || true)"
have_hermes() { command -v hermes >/dev/null 2>&1; }

components() {
    local kit_repo; kit_repo="$(git -C "$KIT_ROOT" remote get-url origin 2>/dev/null | sed -E 's#(git@github.com:|https://github.com/)##; s#\.git$##')"
    printf 'kit\t%s\tkit\n' "${kit_repo:-feelthefusion/ai-kit}"
    grep -v '^#' "$KIT_ROOT/install/upstream-skills.tsv" | awk -F'\t' 'NF>=3 {split($1,a,"/"); print "upstream:" a[1] "/" a[2] "\t" a[1] "/" a[2] "\tupstream"}' | sort -u
    grep -v '^#' "$KIT_ROOT/install/claude-plugins.tsv" | awk -F'\t' 'NF>=3 {print "plugin:" $1 "\t" $2 "\tplugin"}'
}

revision() { git ls-remote "$GIT_BASE/$1" HEAD 2>/dev/null | cut -c1-12; }

check_all() {
    local tmp; tmp="$(mktemp -d)"
    while IFS=$'\t' read -r name repo kind; do
        ( printf '%s\t%s\t%s\t%s\n' "$name" "$repo" "$kind" "$(revision "$repo")" > "$tmp/$(echo "$name" | tr '/:@' '___')" ) &
    done < <(components)
    wait
    cat "$tmp"/* 2>/dev/null | while IFS=$'\t' read -r name repo kind new; do
        old="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("rev",{}).get(sys.argv[2],""))' "$STATE" "$name" 2>/dev/null)"
        printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$repo" "$kind" "$old" "$new"
    done
    rm -rf "$tmp"
}

save_state() {
    ROWS="$1" python3 - "$STATE" <<'PY'
import json, os, sys, time
p = sys.argv[1]
try: s = json.load(open(p))
except Exception: s = {}
rev = s.setdefault("rev", {})
for line in os.environ["ROWS"].splitlines():
    name, repo, kind, old, new = (line.rstrip("\n").split("\t") + [""] * 5)[:5]
    if new: rev[name] = new
s["checked_at"] = int(time.time())
json.dump(s, open(p, "w"), indent=2)
PY
}

state_get() { python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); v=s
for k in sys.argv[2].split("."): v=v.get(k,{}) if isinstance(v,dict) else {}
print(v if not isinstance(v,(dict,list)) else json.dumps(v))' "$STATE" "$1" 2>/dev/null; }

apply_changes() {   # $1 = TSV of changed rows
    local changed="$1" done_list=() hub=0
    while IFS=$'\t' read -r name repo kind old new; do
        [ -n "$name" ] || continue
        case "$kind" in
            kit)
                if [ -n "$(git -C "$KIT_ROOT" status --porcelain)" ]; then echo "kit: local edits in $KIT_ROOT — not pulling"; continue; fi
                git -C "$KIT_ROOT" pull --ff-only --quiet || { echo "kit: pull failed"; continue; }
                [ -n "$CLAUDE_BIN" ] && KIT_NO_PULL=1 bash "$KIT_ROOT/install/install.sh" >>"$LOG" 2>&1
                have_hermes && KIT_NO_PULL=1 bash "$KIT_ROOT/install/hermes.sh" >>"$LOG" 2>&1
                done_list+=("AI Kit $old→$new (skills, CLIs re-synced)") ;;
            upstream)
                local d="$AI_UPSTREAM/$(printf '%s' "$repo" | tr '/' '_')"
                if [ -d "$d/.git" ] && git -C "$d" fetch --depth 1 --filter=blob:none --quiet origin HEAD >>"$LOG" 2>&1 && git -C "$d" reset --hard --quiet FETCH_HEAD; then
                    done_list+=("${repo} skills $old→$new")
                fi
                hub=1 ;;
            plugin)
                if [ -n "$CLAUDE_BIN" ]; then
                    "$CLAUDE_BIN" plugin marketplace update "${name#*@}" >>"$LOG" 2>&1
                    "$CLAUDE_BIN" plugin update "${name#plugin:}" --scope project >>"$LOG" 2>&1 || true
                    done_list+=("${name#plugin:} plugin $old→$new")
                fi
                hub=1 ;;
        esac
    done <<< "$changed"
    [ "$hub" = 1 ] && have_hermes && hermes skills update >>"$LOG" 2>&1
    [ "${#done_list[@]}" -gt 0 ] && printf '%s\n' "${done_list[@]}"
}

run() {   # $1 = apply|check
    local mode="$1" rows changed out=""
    rows="$(check_all)"
    changed="$(awk -F'\t' '$4 != "" && $5 != "" && $4 != $5' <<< "$rows")"
    if [ "$mode" = check ]; then
        [ -n "$changed" ] && awk -F'\t' '{printf "  ↑ %-44s %s → %s\n", $1, $4, $5}' <<< "$changed" || echo "  ✓ everything current"
        return
    fi
    [ -n "$changed" ] && out="$(apply_changes "$changed")"
    save_state "$rows"
    echo "$(date '+%F %T') checked $(wc -l <<< "$rows" | tr -d ' ') components; changed: $(awk -F'\t' '{print $1}' <<< "$changed" | xargs)" >> "$LOG"
    [ -n "$out" ] && printf '%s\n' "$out"
}

# ---- app AI packages vs npm latest (the site's own AI stack) ------------------------------
deps() {  # $1 = repo dir  $2 = apply?(1)
    local root="$1" pkgs pm
    [ -f "$root/package.json" ] || { echo "  · no package.json here"; return 0; }
    pkgs="$(python3 - "$root/package.json" <<'PY'
import json, re, sys
d = json.load(open(sys.argv[1])); deps = {**d.get("dependencies", {}), **d.get("devDependencies", {})}
want = re.compile(r"^(ai|@ai-sdk/.+|@openrouter/ai-sdk-provider|@fingerprintjs/fingerprintjs|@fingerprint/(agent|node-sdk)|@modelcontextprotocol/sdk|promptfoo|@huggingface/transformers)$")
for k, v in deps.items():
    if want.match(k): print(f"{k}\t{v}")
PY
)"
    [ -n "$pkgs" ] || { echo "  · no AI packages in package.json (ai-init adds them)"; return 0; }
    local behind=() name range cur latest
    while IFS=$'\t' read -r name range; do
        latest="$(npm view "$name" version 2>/dev/null)" || continue
        cur="$(node -e 'try{console.log(require(require.resolve(process.argv[1]+"/package.json",{paths:[process.argv[2]]})).version)}catch{console.log("")}' "$name" "$root" 2>/dev/null)"
        [ -z "$cur" ] && cur="${range#^}"; cur="${cur#~}"
        [ "$cur" != "$latest" ] && behind+=("$name $cur → $latest")
    done <<< "$pkgs"
    if [ "${#behind[@]}" -eq 0 ]; then echo "  ✓ AI packages at npm latest"; return 0; fi
    printf '  ↑ %s\n' "${behind[@]}"
    [ "$2" = 1 ] || { echo "  → ai-update --deps --apply"; return 0; }
    pm=npm; [ -f "$root/pnpm-lock.yaml" ] && pm=pnpm; [ -f "$root/yarn.lock" ] && pm=yarn; { [ -f "$root/bun.lockb" ] || [ -f "$root/bun.lock" ]; } && pm=bun
    local list; list="$(cut -f1 <<< "$pkgs" | sed 's/$/@latest/' | xargs)"
    case "$pm" in
        npm) (cd "$root" && npm install $list) ;; pnpm) (cd "$root" && pnpm add $list) ;;
        yarn) (cd "$root" && yarn add $list) ;; bun) (cd "$root" && bun add $list) ;;
    esac && echo "  ✓ upgraded with $pm — run ./verify.sh (or tests) before committing"
}

# A repo that ran ai-init carries .agents/.ai-kit-version; when the kit has moved, re-run ai-init there
# (idempotent: refreshes links, instruction block, verify step, hand-offs — never touches ai-stack.md or evals/).
sync_project() {
    local r="$1" have want
    [ -f "$r/.agents/.ai-kit-version" ] || return 0
    have="$(cat "$r/.agents/.ai-kit-version" 2>/dev/null)"; want="$(git -C "$KIT_ROOT" rev-parse --short=12 HEAD 2>/dev/null)"
    [ -n "$want" ] && [ "$have" != "$want" ] || return 0
    (cd "$r" && bash "$KIT_ROOT/install/init-project.sh" >/dev/null 2>&1) && echo "$(basename "$r") re-synced to AI Kit $want" >> "$NOTICE"
}

fresh() { local t; t="$(state_get checked_at)"; [ -n "$t" ] && [ $(( $(date +%s) - t )) -lt "$TTL" ]; }

case "${1:-}" in
    --hook)
        [ "${AI_UPDATE:-on}" = off ] && exit 0
        payload="$(cat 2>/dev/null || true)"
        event="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1] or "{}").get("hook_event_name",""))' "$payload" 2>/dev/null)"
        repo="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1] or "{}").get("cwd",""))' "$payload" 2>/dev/null)"
        repo="${CLAUDE_PROJECT_DIR:-${repo:-$PWD}}"
        if [ -s "$NOTICE" ]; then
            msg="AI Kit auto-updated since your last session: $(paste -sd ';' "$NOTICE" | sed 's/;/; /g')"
            : > "$NOTICE"
            if [ "$event" = on_session_start ]; then python3 -c 'import json,sys; print(json.dumps({"context": sys.argv[1]}))' "$msg"; else echo "$msg"; fi
        fi
        # background: upstream apply (skipped while a recent check is fresh) + re-sync THIS project if the kit moved
        ( mkdir "$LOCK" 2>/dev/null || exit 0; trap 'rmdir "$LOCK"' EXIT
          fresh || { out="$(run apply)"; [ -n "$out" ] && printf '%s\n' "$out" >> "$NOTICE"
                     [ -f "$repo/.agents/ai-stack.md" ] && { d="$(deps "$repo" 0 | grep '↑' | sed 's/^ *↑ //' | paste -sd ',' -)"; [ -n "$d" ] && echo "$(basename "$repo") AI packages behind npm: $d (ai-update --deps --apply)" >> "$NOTICE"; }; }
          sync_project "$repo" ) </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
        exit 0 ;;
    --check) echo "▶ upstream check (nothing applied)"; run check ;;
    --status)
        echo "AI Kit components  (state: $STATE)"
        rows="$(check_all)"
        awk -F'\t' '{ st = ($4 == "" ? "new" : ($4 == $5 ? "current" : "UPDATE")); printf "  %-8s %-44s %-40s %s\n", st, $1, $2, $5 }' <<< "$rows"
        t="$(state_get checked_at)"; [ -n "$t" ] && echo "last check: $(date -r "$t" '+%F %T' 2>/dev/null || date -d "@$t" '+%F %T')" ;;
    --deps) echo "▶ AI packages vs npm latest ($(git rev-parse --show-toplevel 2>/dev/null || pwd))"
        deps "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" "$([ "${2:-}" = --apply ] && echo 1 || echo 0)" ;;
    ""|--now)
        mkdir "$LOCK" 2>/dev/null || { echo "another ai-update is running"; exit 0; }; trap 'rmdir "$LOCK"' EXIT
        echo "▶ checking upstreams"; out="$(run apply)"
        [ -n "$out" ] && printf '  ✓ %s\n' "$out" || echo "  ✓ everything current" ;;
    -h|--help) sed -n '2,19p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *) echo "usage: ai-update [--check|--status|--deps [--apply]|--hook]" >&2; exit 2 ;;
esac
